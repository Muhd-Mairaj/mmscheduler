# Copy to .env and fill in. The single env file for `docker compose`
# (db + web + scraper all read it; compose also substitutes ${...} below).

# --- Postgres ---
POSTGRES_USER=mmscheduler
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mmscheduler
POSTGRES_PORT=5432
# Local (non-Docker) dev convenience: point tools at localhost.
# Inside compose, web/scraper get DATABASE_URL built from the above and
# pointing at the `db` service automatically.
DATABASE_URL=postgres://mmscheduler:changeme@localhost:5432/mmscheduler

# --- Scraper schedule (hours between runs; no rebuild needed to change) ---
SCRAPE_INTERVAL_HOURS=8
# RUN_ON_START=true   # run once immediately on container start

# --- Scraper: TimeEdit + tuning (same names as scraper/.env.example) ---
# TIMEEDIT_BASE_URL=https://cloud.timeedit.net/my_um/web/students/
# COURSE_CONCURRENCY=40
# COURSE_PAGE_CONCURRENCY=12
# COURSE_PAGE_SIZE=100
# COURSE_MAX_OBJECTS=30000
# COURSE_RETRIES=3
# SCRIPT_RETRIES=3
# NAVIGATION_TIMEOUT_MS=120000
# LECTURER_TIMEOUT_MS=300000
# COURSE_TIMEOUT_MS=3000000
# SESSION_BOUNCE_MS=15000
# SESSION_REAUTH_MS=90000
# LOG_KEEP_DAYS=14
# NOTIFY_WEBHOOK_URL=https://example.com/hook
